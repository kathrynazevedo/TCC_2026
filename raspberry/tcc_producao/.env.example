# Copie para ".env" e ajuste. O ".env" nunca deve ser commitado.

# Endereço do servidor que roda o backend Node.js (IP da máquina na rede local ou domínio do deploy)
API_BASE_URL=https://tcc-2026-mfxn.onrender.com
# Mesma chave definida em EDGE_API_KEY no servidor (painel do Render ou backend_api/.env)
EDGE_API_KEY=
# ID do dispositivo na tabela dispositivo_borda
ID_DISPOSITIVO=1

# Webcam (índice, ex.: 0) ou câmera IP/DVR (URL RTSP completa)
CAMERA_SOURCE=0
# CAMERA_SOURCE=rtsp://usuario:senha@192.168.1.209:554/cam/realmonitor?channel=1&subtype=1

# Arquivo do modelo (padrão: modelo_pessoa_epi.tflite, na pasta do programa)
# MODELO_PATH=
# Modelo de 3 classes (pessoa, capacete, colete): a infração é a AUSÊNCIA do EPI dentro da caixa da pessoa.
# Confiança mínima para aceitar uma pessoa, e para aceitar um capacete/colete como PRESENTE.
# Limiar baixo demais deixa passar um EPI falso (ex.: "colete" a 53% sobre uma camiseta) e esconde a falta;
# alto demais acusa quem está equipado. O colete é mais exigente por padrão. Revalide a cada modelo novo.
# CONFIANCA_PESSOA=0.65   # nunca abaixo de 0.50: o banco da API recusa infração com confiança menor que isso
# CONFIANCA_CAPACETE=0.50
# CONFIANCA_COLETE=0.65
# CONFIANCA_EPI=0.50   # (opcional) um único valor para capacete e colete
# Altura mínima (px, quadro 640x480) para julgar uma pessoa: quem está longe demais não tem EPI visível.
# ALTURA_MINIMA_PESSOA=120
# Segundos de falta CONTÍNUA de EPI antes de alertar (um capacete que o modelo deixa de ver por 1 quadro não alerta).
# TEMPO_CONFIRMACAO=1.0
# Segundos para repetir o alerta de quem CONTINUA sem o EPI (0 = um único alerta enquanto a pessoa estiver em cena)
# TEMPO_REALERTA=0
# Rastreamento: segundos sem ver a pessoa antes de esquecê-la / distância máxima (px) entre frames para ser a mesma
# RASTREADOR_TEMPO_AUSENTE=10
# RASTREADOR_DIST_MAXIMA=150
# Segundos sem aparecer até a pessoa sair da contagem "em cena" (a numeração 1, 2, 3... se recompacta).
# Conta TODAS as pessoas em cena, com ou sem EPI.
# RASTREADOR_TEMPO_PRESENTE=3
# Métricas de desempenho no terminal e no arquivo metricas.csv, a cada N segundos (0 = desligado)
# INTERVALO_METRICAS=10
# Sirene: pino FÍSICO do relé (modo BOARD; 11 = o do teste de bancada), nível que LIGA o relé ("baixo" ou "alto")
# e quantos segundos ela toca a cada alerta. Se a sirene tocar sozinha ao ligar, inverta SIRENE_ATIVA_EM.
# PINO_SIRENE=11
# SIRENE_ATIVA_EM=baixo
# DURACAO_SIRENE=2
# Reinício programado do turno: horas de operação até o programa reiniciar sozinho (0 = desligado).
# "programa" reabre só o main.py; "placa" faz `sudo reboot` (exige o serviço systemd subindo o programa no boot).
# O reinício espera um momento sem ninguém em cena, por no máximo REINICIO_TOLERANCIA_S segundos.
# REINICIAR_APOS_HORAS=8
# REINICIO_MODO=programa
# REINICIO_TOLERANCIA_S=600
# Resultado da validação do modelo (mAP por classe), gerado no Colab; aparece na tela Sistema.
# ARQUIVO_VALIDACAO=validacao_modelo.json
# MOSTRAR_JANELA=false
