# Copie para ".env" e ajuste. O ".env" nunca deve ser commitado.

# Endereço do servidor que roda o backend Node.js (IP da máquina na rede local ou domínio do deploy)
API_BASE_URL=https://tcc-2026-mfxn.onrender.com
# Mesma chave definida em EDGE_API_KEY no servidor (painel do Render ou backend_api/.env)
EDGE_API_KEY=
# ID do dispositivo na tabela dispositivo_borda
ID_DISPOSITIVO=1

# Webcam (índice, ex.: 0) ou câmera IP/DVR (URL RTSP completa)
CAMERA_SOURCE=0
# CAMERA_SOURCE=rtsp://usuario:senha@192.168.1.209:554/cam/realmonitor?channel=1&subtype=1

# CONFIANCA_MINIMA=0.70
# Segundos para repetir o alerta de quem CONTINUA sem o EPI (0 = um único alerta enquanto a pessoa estiver em cena)
# TEMPO_REALERTA=0
# Rastreamento: segundos sem ver a pessoa antes de esquecê-la / distância máxima (px) entre frames para ser a mesma
# RASTREADOR_TEMPO_AUSENTE=10
# RASTREADOR_DIST_MAXIMA=150
# Segundos sem aparecer até a pessoa sair da contagem "em cena" (a numeração 1, 2, 3... se recompacta).
# Conta TODAS as pessoas em cena, com ou sem EPI.
# RASTREADOR_TEMPO_PRESENTE=3
# PINO_SIRENE=18
# MOSTRAR_JANELA=false
