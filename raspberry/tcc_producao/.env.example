# Copie para ".env" e ajuste (na placa: cp .env.example .env && nano .env). O ".env" nunca deve ser commitado.
# Só as três primeiras seções precisam de atenção; o resto já vem com os valores de produção (linhas com "#").

# ---------- API ----------
# Endereço do servidor que roda o backend Node.js (IP da máquina na rede local ou domínio do deploy)
API_BASE_URL=https://tcc-2026-mfxn.onrender.com
# Mesma chave definida em EDGE_API_KEY no servidor (painel do Render ou backend_api/.env). Nunca coloque em código nem em chat.
EDGE_API_KEY=
# ID do dispositivo na tabela dispositivo_borda
ID_DISPOSITIVO=1

# ---------- Câmera ----------
# Webcam (índice, ex.: 0) ou câmera IP/DVR (URL RTSP completa). Com câmera de rede, troque as duas linhas:
CAMERA_SOURCE=0
# CAMERA_SOURCE=rtsp://usuario:senha@IP_DA_CAMERA:554/cam/realmonitor?channel=1&subtype=1
# Câmera de RESERVA (opcional): fica em espera e só assume quando a principal passa CAMERA_TROCA_APOS segundos sem imagem.
# Só uma câmera é analisada por vez. Com a reserva em uso, a principal é testada a cada CAMERA_VOLTAR_A_CADA segundos e a
# captura volta para ela quando responde (0 = não volta sozinha). CAMERA_TIMEOUT_S é o prazo para abrir e ler a câmera de rede.
# CAMERA_SOURCE_SECUNDARIA=rtsp://usuario:senha@IP_DA_RESERVA:554/cam/realmonitor?channel=1&subtype=1
# CAMERA_TROCA_APOS=5
# CAMERA_VOLTAR_A_CADA=30
# CAMERA_TIMEOUT_S=5

# ---------- Sirene (relé no GPIO) ----------
# A sirene fica LIGADA enquanto houver alguém sem EPI na frente da câmera e cala sozinha quando todos estiverem
# equipados (ou saírem de cena). Pino FÍSICO do relé (modo BOARD; 11 = o do teste de bancada) e nível que LIGA o relé
# ("baixo" ou "alto"). Se a sirene tocar sozinha ao ligar o programa, inverta SIRENE_ATIVA_EM.
# Confira de ouvido com: python3 testar_sirene.py
# PINO_SIRENE=11
# SIRENE_ATIVA_EM=baixo
# Como DESLIGAR: "true" (padrão) SOLTA o pino (entrada, sem pull). Módulos de relé de 5 V comandados por um pino de
# 3,3 V em geral NÃO desligam com o nível alto (foi o caso da bancada); "false" conduz o nível de repouso.
# SIRENE_DESLIGA_SOLTANDO=true
# Segundos sem nenhuma infração na cena até a sirene calar (também é o tempo mínimo que ela toca). Evita que ela pique
# quando o modelo deixa de ver a falta por um quadro.
# SIRENE_DESLIGA_APOS=2

# ---------- Modelo e limiares (valores de produção; revalide a cada modelo novo) ----------
# Arquivo do modelo (padrão: modelo_pessoa_epi.tflite, na pasta do programa). Precisa ter pessoa, capacete e colete.
# MODELO_PATH=
# Confiança mínima para aceitar uma PESSOA. Nunca abaixo de 0.50: o banco da API recusa infração com confiança menor.
# CONFIANCA_PESSOA=0.65
# Confiança mínima para aceitar um capacete/colete como PRESENTE. Baixo demais deixa passar um EPI falso (ex.: "colete"
# a 53% sobre uma camiseta) e esconde a falta; alto demais acusa quem está equipado. O colete é mais exigente.
# CONFIANCA_CAPACETE=0.50
# CONFIANCA_COLETE=0.65
# CONFIANCA_EPI=0.50   # (opcional) um único valor para capacete e colete
# Altura mínima (px, quadro 640x480) para julgar uma pessoa: quem está longe demais não tem EPI visível.
# ALTURA_MINIMA_PESSOA=120

# ---------- Regras de alerta ----------
# Segundos de falta CONTÍNUA de EPI antes de alertar (um capacete que o modelo deixa de ver por 1 quadro não alerta).
# TEMPO_CONFIRMACAO=1.0
# Segundos para repetir o alerta de quem CONTINUA sem o EPI (0 = um único alerta enquanto a pessoa estiver em cena)
# TEMPO_REALERTA=0
# Rastreamento: segundos sem ver a pessoa antes de esquecê-la / distância máxima (px) entre frames para ser a mesma
# RASTREADOR_TEMPO_AUSENTE=10
# RASTREADOR_DIST_MAXIMA=150
# Segundos sem aparecer até a pessoa sair da contagem "em cena" (a numeração 1, 2, 3... se recompacta).
# RASTREADOR_TEMPO_PRESENTE=3

# ---------- Operação ----------
# Reinício programado do turno: horas de operação até o programa reiniciar sozinho (0 = desligado). Espera um
# momento sem ninguém em cena, por no máximo REINICIO_TOLERANCIA_S segundos. "programa" reabre só o main.py;
# "placa" faz `sudo reboot` (só vale com o serviço systemd subindo o programa no boot: bash instalar_servico.sh).
# REINICIAR_APOS_HORAS=8
# REINICIO_MODO=programa
# REINICIO_TOLERANCIA_S=600
# Segundos entre os resumos de métricas (terminal, painel e metricas.csv). Mínimo prático: 1.
# INTERVALO_METRICAS=10
# Resultado da validação do modelo (mAP por classe), gerado no Colab; aparece na tela Sistema.
# ARQUIVO_VALIDACAO=validacao_modelo.json
# Alertas que não chegaram à API ficam em pendentes/ (no máximo MAX_PENDENTES) e são reenviados a cada
# INTERVALO_SINCRONIZACAO segundos; o sinal de vida vai a cada INTERVALO_HEARTBEAT segundos.
# MAX_PENDENTES=200
# INTERVALO_SINCRONIZACAO=60
# INTERVALO_HEARTBEAT=30
# Só para depuração com monitor: mostra a janela de vídeo com as métricas.
# MOSTRAR_JANELA=false
