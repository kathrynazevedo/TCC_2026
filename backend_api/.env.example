# Copie este arquivo para ".env" e preencha. O ".env" nunca deve ser commitado.

PORT=3000
# Use NODE_ENV=production no deploy (exige EDGE_API_KEY e restringe o CORS).
NODE_ENV=development

# Postgres (Neon): Dashboard do Neon > Connection string
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# DATABASE_SSL=false          # somente para Postgres local sem SSL
# DATABASE_SSL_VERIFY=false   # somente se o driver reclamar do certificado do provedor

# Cloudinary (armazenamento das imagens de evidência)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chave compartilhada com a Raspberry Pi (header x-api-key). Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EDGE_API_KEY=

# Origens permitidas do dashboard, separadas por vírgula. Vazio = qualquer origem (só em dev).
# CORS_ORIGIN=http://localhost:5173

# UPLOAD_MAX_MB=5
# EDGE_OFFLINE_AFTER_SECONDS=90
