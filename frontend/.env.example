# Opcional. Copie para ".env.local" apenas se precisar mudar os padrões.

# URL da API. Padrão: "/api" (o Vite repassa ao backend em dev; em produção o backend serve o front).
# VITE_API_URL=http://localhost:3000/api

# Para onde o servidor de desenvolvimento repassa "/api".
# VITE_PROXY_TARGET=http://localhost:3000

# IP da Raspberry Pi exibido na tela "Sistema" (apenas informativo).
# VITE_EDGE_IP=192.168.1.210
